# ─────────────────────────────────────────────────────────────
# Internship Hunter — Environment Variables
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env — it's in .gitignore
#
# For GitHub Actions: add these as repository Secrets at
#   Settings → Secrets and variables → Actions → New repository secret
# ─────────────────────────────────────────────────────────────

# ── Gmail (required for email notifications) ─────────────────
# Use a Google App Password, NOT your regular Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Telegram (required for Telegram notifications) ────────────
# Create a bot via @BotFather, get your chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Optional overrides (all have defaults in config.json) ─────
# STRICT_PAID_ONLY=true
# MIN_STIPEND_INR=5000
# LINKEDIN_MIN_QUALITY=6
# LINKEDIN_REQUIRE_INTERNSHIP_HINT=true
# EXCLUDE_US_ONLY_ROLES=true
# SOURCE_CAP_LINKEDIN_INDIAN=10
# SOURCE_CAP_LINKEDIN_OFFSHORE=10
# LINKEDIN_MAX_PER_OFFSHORE_COUNTRY=3
# SOURCE_CAP_INTERNSHALA=5
# SOURCE_CAP_UNSTOP=5
# LINKEDIN_MAX_PAGES=1
